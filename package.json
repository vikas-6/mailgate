{
  "name": "mailgate",
  "version": "1.1.0",
  "description": "Fast, offline-first email validation and fraud detection library for Node.js",
  "main": "src/validator.js",
  "exports": {
    ".": "./src/validator.js",
    "./server": "./src/server.js"
  },
  "bin": {
    "mailgate": "bin/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "lint": "eslint src/ bin/ tests/",
    "lint:fix": "eslint src/ bin/ tests/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "email-validation",
    "disposable-email",
    "email-fraud-detection",
    "spam-prevention",
    "email-verifier",
    "throwaway-email",
    "mx-validation",
    "anti-fraud"
  ],
  "author": "vikas-6 (https://github.com/vikas-6)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vikas-6/mailgate.git"
  },
  "bugs": {
    "url": "https://github.com/vikas-6/mailgate/issues"
  },
  "homepage": "https://mailgate.netlify.app/",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "src/",
    "bin/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.3.3"
  }
}
